# Copiez ce fichier vers .env.local pour le développement.
# Sur Vercel : Project Settings → Environment Variables.

# Neon, Vercel Postgres ou autre PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Chaîne secrète longue et unique (session admin) — obligatoire
SESSION_SECRET=remplacez-par-une-chaine-aleatoire-longue

# Compte administrateur créé au premier lancement, uniquement tant qu'aucun
# compte n'existe en base. Sans SEED_ADMIN_PASSWORD, aucun compte n'est créé.
SEED_ADMIN_USERNAME=bibliothecaire
SEED_ADMIN_PASSWORD=mot-de-passe-long-et-unique
SEED_ADMIN_DISPLAY_NAME=Bibliothécaire
