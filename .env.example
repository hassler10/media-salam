# Copiez ce fichier vers .env.local pour le développement.
# Sur Vercel : Project Settings → Environment Variables.

# Neon, Vercel Postgres ou autre PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Chaîne secrète longue et unique (session admin)
SESSION_SECRET=remplacez-par-une-chaine-aleatoire-longue
